# Copy to .env and fill in. Never commit .env.

# --- Database (Spring Boot backend) ---
DATABASE_URL=jdbc:postgresql://aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_USER=postgres.ikmzwnyaijkvpqisgzms
DATABASE_PASSWORD=your_supabase_password_here
# Optional pool tuning (defaults shown; safe for the transaction pooler on port 6543):
# DB_POOL_MAX_SIZE=5
# DB_POOL_MIN_IDLE=1
# DB_CONNECTION_TIMEOUT_MS=10000
# DB_IDLE_TIMEOUT_MS=300000
# DB_MAX_LIFETIME_MS=900000
# DB_PREPARE_THRESHOLD=0   # keep 0 with the pooler; server-side prepared statements break under it
# SHUTDOWN_TIMEOUT=20s     # graceful-shutdown grace period

# --- Backend API ---
# Comma-separated origins allowed by CORS (the Next.js frontend). Default: http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# --- Supabase (agents + pipelines; service role bypasses RLS — server-side only) ---
SUPABASE_URL=https://ikmzwnyaijkvpqisgzms.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- AI model for agents / extraction (provider not chosen yet) ---
# LLM_PROVIDER: anthropic | openai | gemini
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# --- Embeddings (must output exactly 1536 dimensions) ---
# EMBEDDING_PROVIDER: openai | gemini | voyage | ...
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1536

# --- Phase 1 data sources (official APIs only) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=idea-finder/0.1 (by u/your_reddit_username)
GITHUB_TOKEN=
STACKEXCHANGE_KEY=
# Hacker News: official API, no key needed

# --- GitLab (agents open/merge MRs): project access token, Maintainer, scopes api + write_repository ---
GITLAB_TOKEN=

# --- Phase 2 data sources (not used in v1; official API / data partner only) ---
# G2_API_KEY=
# CAPTERRA_API_KEY=

# --- User Simulator test accounts (one per tier; test accounts only) ---
TEST_USER_FREE_EMAIL=
TEST_USER_FREE_PASSWORD=
TEST_USER_PRO_EMAIL=
TEST_USER_PRO_PASSWORD=
TEST_USER_ENTERPRISE_EMAIL=
TEST_USER_ENTERPRISE_PASSWORD=
